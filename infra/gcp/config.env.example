# ---------------------------------------------------------------------------
# Self-Serve GCP bootstrap configuration — copy to config.env and fill in.
#   cp config.env.example config.env && edit config.env
# config.env is gitignored. NEVER commit real values or secrets.
# ---------------------------------------------------------------------------

# Your GCP project ID (NOT the display name "SelfService").
# Find it with:  gcloud projects list --filter='name:SelfService'
export PROJECT_ID="REPLACE_WITH_PROJECT_ID"

# Region for regional resources.
#   me-central2  = Dammam, KSA  -> PDPL-preferred for Tier-4 data. Requires the
#                  CNTXT reseller + Invoiced Billing onboarding. This project IS
#                  CNTXT-onboarded, so this is the default.
#   me-central1  = Doha, Qatar  -> fallback usable on standard billing; outside
#                  KSA borders => weaker PDPL posture (not used here).
export REGION="${REGION:-me-central2}"

# GitHub repository allowed to assume the deploy identity via WIF (owner/name).
export GITHUB_REPO="murad1981/self-service"

# Environments (single-project POC model — separated by resource naming + IAM).
export ENVS="${ENVS:-qa staging production}"

# Resource name prefix.
export PREFIX="${PREFIX:-selfserve}"

# Artifact Registry Docker repository name.
export AR_REPO="${AR_REPO:-${PREFIX}-docker}"

# WIF pool / provider IDs.
export WIF_POOL="${WIF_POOL:-github-pool}"
export WIF_PROVIDER="${WIF_PROVIDER:-github-provider}"
